COMPOSE_PROJECT_NAME=isolated-agent-demo

# Directory that becomes /workspace inside the agent.
# Prefer an absolute path for real projects.
PROJECT_DIR=./workspace

BASE_IMAGE=localhost/isolated-agent-base:dev
CODEX_IMAGE=localhost/isolated-agent-codex:dev
DEPENDENCIES_IMAGE=localhost/isolated-agent-dependencies:dev
# SDKs, compilers, local files and Agent Tools are described in
# dependencies/dependencies.toml (not in the Debian Base image).
# PROJECT_IMAGE=localhost/isolated-agent-project:dev  # override only if intentionally shared

# Legacy extra APT packages in the Project layer. Prefer
# dependencies/dependencies.toml for language toolchains and system packages.
# Third image layer: project-specific native packages.
# Example: PROJECT_APT_PACKAGES=libpq-dev gstreamer1.0-tools
PROJECT_APT_PACKAGES=

# Generic image-level Codex instructions.
# Project-specific instructions belong in PROJECT_DIR/AGENTS.md.
CODEX_AGENTS_FILE=templates/AGENTS.global.md

# Leave CODEX_MODEL empty to use the Codex/account default.
CODEX_MODEL=
CODEX_MODEL_REASONING_EFFORT=high
CODEX_PLAN_REASONING_EFFORT=high
CODEX_MODEL_VERBOSITY=
CODEX_PERSONALITY=
CODEX_REVIEW_MODEL=
CODEX_SERVICE_TIER=
CODEX_FILE_OPENER=none

# The outer rootless Podman container is the primary isolation boundary.
# Do not enable Codex's Bubblewrap workspace sandbox by default inside this
# rootless container: nested user namespaces are commonly unavailable.
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX_MODE=danger-full-access

# Used only when CODEX_SANDBOX_MODE=workspace-write on a compatible host.
CODEX_NETWORK_ACCESS=true
CODEX_WEB_SEARCH=cached
CODEX_PROJECT_DOC_MAX_BYTES=65536

# Filter common secret-bearing environment variables before shell commands.
CODEX_SHELL_IGNORE_DEFAULT_EXCLUDES=false

# Image-level default only. Prefer PROJECT_DIR/.codex/config.toml for
# project-specific model/features so shared images remain reusable.
CODEX_FEATURE_MEMORIES=true

# Persistent memory/state directories INSIDE this isolated-agent checkout.
# Auto-created by 'make up', 'make offline', 'make recreate-agent' or
# 'make up-serena'. Each base gets its own <project-key> child directory,
# derived from COMPOSE_PROJECT_NAME and canonical PROJECT_DIR.
# Result examples: ./volumes/codex/<key> and ./volumes/serena/<key>.
# Paths are host bind mounts, not Podman named volumes.
CODEX_STATE_VOLUME=./volumes/codex
SERENA_STATE_VOLUME=./volumes/serena
# For backward compatibility a bare name (no path slash), e.g.
# CODEX_STATE_VOLUME=isolated-agent-demo_codex-state
# still selects an existing Podman named volume.
# Serena *project* memories remain in PROJECT_DIR/.serena/memories/.
#
# Use only for one-time claim of an ALREADY populated pre-existing volume.
# Check it is the right project's state before opting in; turn off afterward.
# CODEX_BIND_EXISTING_STATE=true
# SERENA_BIND_EXISTING_STATE=true

# Optional fourth image layer: Serena semantic MCP + Go language server.
# Only used by make build-serena and compose.serena.yaml.
# SERENA_IMAGE=localhost/isolated-agent-serena:dev  # override only if intentionally shared
SERENA_VERSION=1.7.0
SERENA_GOPLS_VERSION=v0.20.0

# Auto-select free project-specific subnet and reuse a validated existing network.
# For manual override, set AGENT_SUBNET to a unique IPv4 CIDR.
AGENT_SUBNET=auto
# Optional. Leave commented for project-specific network names.
# Set the SAME value in different Compose projects to join a shared network.
# Their COMPOSE_PROJECT_NAME values must remain different for data isolation.
# AGENT_NETWORK_NAME=team-development
BLOCK_CIDRS=
SQUID_IMAGE=docker.io/ubuntu/squid:6.6-24.04_edge
