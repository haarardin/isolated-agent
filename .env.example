COMPOSE_PROJECT_NAME=isolated-agent-demo

# Directory that becomes /workspace inside the agent.
# Prefer an absolute path for real projects.
PROJECT_DIR=./workspace

BASE_IMAGE=localhost/isolated-agent-base:dev
CODEX_IMAGE=localhost/isolated-agent-codex:dev
PROJECT_IMAGE=localhost/isolated-agent-project:dev

# Third image layer: project-specific native packages.
# Example: PROJECT_APT_PACKAGES=libpq-dev gstreamer1.0-tools
PROJECT_APT_PACKAGES=

# File inside the image build context that becomes the global Codex AGENTS.md.
CODEX_AGENTS_FILE=templates/AGENTS.project.md

# Leave CODEX_MODEL empty to use the Codex/account default.
CODEX_MODEL=
CODEX_MODEL_REASONING_EFFORT=high
CODEX_PLAN_REASONING_EFFORT=high
CODEX_MODEL_VERBOSITY=
CODEX_PERSONALITY=
CODEX_REVIEW_MODEL=
CODEX_SERVICE_TIER=
CODEX_FILE_OPENER=none

# The outer rootless Podman container is the primary isolation boundary.
# Codex keeps its own workspace sandbox as defense in depth.
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX_MODE=workspace-write
CODEX_NETWORK_ACCESS=true
CODEX_WEB_SEARCH=cached
CODEX_PROJECT_DOC_MAX_BYTES=65536

# Filter common secret-bearing environment variables before shell commands.
CODEX_SHELL_IGNORE_DEFAULT_EXCLUDES=false

# Codex memories are currently experimental; enable per project if desired.
CODEX_FEATURE_MEMORIES=false
