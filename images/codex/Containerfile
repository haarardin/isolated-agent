ARG BASE_IMAGE=localhost/isolated-agent-base:dev
FROM ${BASE_IMAGE}

RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh \
    && codex --version
# Keep the entire official package intact outside CODEX_HOME: CLI releases
# >=0.157 need codex-package.json and bundled binaries/resources to bootstrap
# the managed app-server daemon. A copied standalone executable is insufficient.
# CODEX_HOME is a writable runtime bind mount that masks its image contents.
RUN mkdir -p /opt/isolated-agent/codex-standalone \
    && test -x /root/.codex/packages/standalone/current/bin/codex \
    && test -f /root/.codex/packages/standalone/current/codex-package.json \
    && cp -a /root/.codex/packages/standalone/. /opt/isolated-agent/codex-standalone/ \
    && test -x /opt/isolated-agent/codex-standalone/current/bin/codex \
    && test -f /opt/isolated-agent/codex-standalone/current/codex-package.json \
    && test -x /opt/isolated-agent/codex-standalone/current/bin/codex-code-mode-host \
    && test -x /opt/isolated-agent/codex-standalone/current/codex-path/rg \
    && ln -sfn /opt/isolated-agent/codex-standalone/current/bin/codex /usr/local/bin/codex \
    && ln -sfn /opt/isolated-agent/codex-standalone/current/bin/codex /root/.local/bin/codex \
    && test "$(readlink -f /usr/local/bin/codex)" = "$(readlink -f /root/.local/bin/codex)" \
    && codex --version

WORKDIR /workspace

CMD ["sleep", "infinity"]
