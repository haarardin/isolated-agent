FROM docker.io/library/debian:13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       build-essential \
       ca-certificates \
       curl \
       fd-find \
       git \
       iproute2 \
       iputils-ping \
       jq \
       less \
       make \
       netcat-openbsd \
       openssh-client \
       pkg-config \
       procps \
       ripgrep \
       tzdata \
       tar \
       unzip \
       xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p \
    /workspace \
    /root/.cache \
    /root/.codex \
    /etc/codex \
    /opt/isolated-agent

ENV HOME=/root
ENV CODEX_HOME=/root/.codex
ENV PATH=/usr/local/bin:/root/.local/bin:${PATH}

WORKDIR /workspace

CMD ["sleep", "infinity"]
