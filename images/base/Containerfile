ARG GO_IMAGE=docker.io/library/golang:1.27-bookworm
FROM ${GO_IMAGE}

ARG AGENT_UID=1000
ARG AGENT_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       build-essential \
       ca-certificates \
       curl \
       fd-find \
       git \
       iproute2 \
       iputils-ping \
       jq \
       less \
       make \
       netcat-openbsd \
       openssh-client \
       pkg-config \
       procps \
       ripgrep \
       tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${AGENT_GID}" agent \
    && useradd --uid "${AGENT_UID}" --gid "${AGENT_GID}" \
       --create-home --shell /bin/bash agent \
    && mkdir -p \
       /workspace \
       /home/agent/.cache \
       /home/agent/.codex \
    && chown -R agent:agent \
       /workspace \
       /home/agent

ENV HOME=/home/agent
ENV GOCACHE=/home/agent/.cache/go-build
ENV GOMODCACHE=/home/agent/.cache/go-mod
ENV PATH=/home/agent/.local/bin:${PATH}

USER agent
WORKDIR /workspace

CMD ["sleep", "infinity"]
