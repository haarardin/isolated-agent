ARG CODEX_IMAGE=localhost/isolated-agent-codex:dev
FROM ${CODEX_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm chromium xvfb x11vnc \
    libreoffice-writer fonts-dejavu-core fonts-liberation \
    poppler-utils python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*
# Versions confirmed against the upstream project manifests at implementation time.
RUN npm install --global --no-audit --no-fund \
    @playwright/mcp@0.0.79 @knorq/docx-mcp-server@3.5.0 \
    && command -v playwright-mcp && command -v docx-mcp-server
RUN python3 -m venv /opt/jobdocs \
    && /opt/jobdocs/bin/pip install --no-cache-dir \
       python-docx docxtpl pymupdf pillow
ENV PATH="/opt/jobdocs/bin:${PATH}"
COPY job-apply/jobctl.py /opt/jobapply/jobctl.py
COPY job-apply/smoke_browser.js /opt/jobapply/smoke_browser.js
COPY job-apply/test-form.html /opt/jobapply/test-form.html
COPY job-apply/browser-start.sh /opt/jobapply/browser-start.sh
RUN chmod +x /opt/jobapply/browser-start.sh && mkdir -p /workspace
WORKDIR /workspace
