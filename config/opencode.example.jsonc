{
  "$schema": "https://opencode.ai/config.json",
  "model": "proxyapi/qwen-flash",
  "providers": {
    "proxyapi": {
      "name": "ProxyAPI",
      "env": ["PROXYAPI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.proxyapi.ru/v1"
      },
      "models": {
        "qwen-flash": {
          "name": "Qwen Flash via ProxyAPI",
          "modelID": "qwen/qwen3.8-flash"
        }
      }
    }
  }
}
